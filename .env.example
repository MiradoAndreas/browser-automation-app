# Clerk Authentication
# Configure the authentication redirect URLs.
# These paths should match your application's sign-in and sign-up routes.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Clerk API Keys
# Create a Clerk application at https://dashboard.clerk.com
# Copy the Publishable Key and Secret Key from your Clerk API Keys settings.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ==========================================
# Neon Database
# Create a PostgreSQL database at https://neon.tech
# DATABASE_URL: Pooled connection string (recommended for serverless environments).
# DATABASE_URL_UNPOOLED: Direct connection string (useful for migrations).
# NEON_BRANCH: Database branch to use (dev for development, main for production).
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""
NEON_BRANCH=dev

# ==========================================
# Trigger.dev
# Create a project at https://trigger.dev
# Copy your project's Secret Key from the Trigger.dev dashboard.
TRIGGER_SECRET_KEY=
